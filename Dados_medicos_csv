        "import pandas as pd\n",
        "import random\n",
        "import os\n",
        "\n",
        "# Listas de dados\n",
        "medicos = [\"Mariana\", \"Fábio\", \"Guilherme\", \"Roberto\", \"Marcos\", \"Sônia\"]\n",
        "meses = [\"NOVEMBRO\", \"DEZEMBRO\", \"JANEIRO\", \"FEVEREIRO\", \"MARÇO\"]\n",
        "\n",
        "# Funções auxiliares para gerar os dados\n",
        "def gerar_remuneracao():\n",
        "    return random.randint(100, 25000)\n",
        "\n",
        "def gerar_horas_trabalhadas():\n",
        "    return random.choice([8, 16, 24, 32, 40, 48, 56, 64, 72])\n",
        "\n",
        "# Criando lista para armazenar os dados\n",
        "dados = []\n",
        "\n",
        "# Gerando 200 registros fictícios\n",
        "for _ in range(200):\n",
        "    medico = random.choice(medicos)\n",
        "    mes = random.choice(meses)\n",
        "    remuneracao = gerar_remuneracao()\n",
        "    horas_trabalhadas = gerar_horas_trabalhadas()\n",
        "\n",
        "    dados.append([medico, mes, remuneracao, horas_trabalhadas])\n",
        "\n",
        "# Criando DataFrame\n",
        "df = pd.DataFrame(dados, columns=[\"Médico\", \"Mês\", \"Total Remunerado\", \"Total de Horas Trabalhadas\"])\n",
        "\n",
        "# Diretório seguro para salvar o arquivo\n",
        "diretorio_temp = os.path.join(os.path.expanduser(\"~\"), \"Downloads\")  # Alternativamente, use \"/tmp\" no Linux/macOS\n",
        "os.makedirs(diretorio_temp, exist_ok=True)\n",
        "\n",
        "# Caminho do arquivo CSV\n",
        "caminho_arquivo = os.path.join(diretorio_temp, \"dados_medicos.csv\")\n",
        "\n",
        "# Salvando em arquivo CSV\n",
        "df.to_csv(caminho_arquivo, index=False, sep=';', encoding='utf-8')\n",
        "\n",
        "# Verificação se o arquivo foi salvo corretamente\n",
        "if os.path.exists(caminho_arquivo):\n",
        "    print(\"Arquivo CSV gerado com sucesso!\")\n",
        "    print(f\"Arquivo salvo em: {caminho_arquivo}\")\n",
        "else:\n",
        "    print(\"Erro ao salvar o arquivo.\")\n"
