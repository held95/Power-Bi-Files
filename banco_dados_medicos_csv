        "import pandas as pd\n",
        "import random\n",
        "import os\n",
        "\n",
        "# Listas de dados\n",
        "medicos = [\"Roberto\", \"Guilherme\", \"Mariana\", \"Regina\", \"Sônia\", \"Marcos\", \"Fábio\"]\n",
        "meses = [\"NOVEMBRO\", \"DEZEMBRO\", \"JANEIRO\", \"FEVEREIRO\", \"MARÇO\"]\n",
        "casos = [\"Demanda Espontânea\", \"Cirurgia\", \"Exame Rotina\", \"Encaminhamento\"]\n",
        "\n",
        "# Criando lista para armazenar os dados\n",
        "dados_medicos = []\n",
        "\n",
        "# Gerando 200 registros fictícios\n",
        "for _ in range(200):\n",
        "    medico = random.choice(medicos)\n",
        "    mes = random.choice(meses)\n",
        "    caso = random.choice(casos)\n",
        "\n",
        "    dados_medicos.append([medico, mes, caso])\n",
        "\n",
        "# Criando DataFrame\n",
        "df_medicos = pd.DataFrame(dados_medicos, columns=[\"MÉDICO\", \"MÊS\", \"TIPO_CASO\"])\n",
        "\n",
        "# Diretório seguro para salvar o arquivo\n",
        "diretorio_temp = os.path.join(os.path.expanduser(\"~\"), \"Downloads\")  # Alternativamente, use \"/tmp\" no Linux/macOS\n",
        "os.makedirs(diretorio_temp, exist_ok=True)\n",
        "\n",
        "# Caminho do arquivo CSV\n",
        "caminho_medicos = os.path.join(diretorio_temp, \"tabela_medicos.csv\")\n",
        "\n",
        "# Salvando em arquivo CSV\n",
        "df_medicos.to_csv(caminho_medicos, index=False, sep=';', encoding='utf-8')\n",
        "\n",
        "# Verificação se o arquivo foi salvo corretamente\n",
        "if os.path.exists(caminho_medicos):\n",
        "    print(\"Arquivo CSV gerado com sucesso!\")\n",
        "    print(f\"Arquivo salvo em: {caminho_medicos}\")\n",
        "else:\n",
        "    print(\"Erro ao salvar o arquivo.\")\n"
      ]
    }
